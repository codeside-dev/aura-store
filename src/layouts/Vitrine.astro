---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

/* "Support" figure dans le design mais n'a pas de page : il est rendu en texte
   tant que la page n'existe pas, plutot que comme un lien qui ne mene nulle part. */
const nav = [
  { label: "Boutique", href: "/boutique" },
  { label: "Casques", href: "/boutique?categorie=casques" },
  { label: "Enceintes", href: "/boutique?categorie=enceintes" },
  { label: "Platines", href: "/boutique?categorie=platines" },
  { label: "Support", href: "/assistance" },
];

/* Colonnes du pied de page, telles que dans le .pen. Chaque entree mene a la
   section correspondante de la page d'information. */
const colonnes = [
  {
    titre: "Boutique",
    liens: [
      { label: "Boutique", href: "/boutique" },
      { label: "Casques", href: "/boutique?categorie=casques" },
      { label: "Enceintes", href: "/boutique?categorie=enceintes" },
      { label: "Platines", href: "/boutique?categorie=platines" },
    ],
  },
  {
    titre: "Assistance",
    liens: [
      { label: "Livraison", href: "/assistance#livraison" },
      { label: "Retours", href: "/assistance#retours" },
      { label: "Garantie", href: "/assistance#garantie" },
    ],
  },
  {
    titre: "Entreprise",
    liens: [
      { label: "À propos", href: "/a-propos#a-propos" },
      { label: "Environnement", href: "/a-propos#environnement" },
      { label: "Presse", href: "/a-propos#presse" },
    ],
  },
  {
    titre: "Légal",
    liens: [
      { label: "Conditions", href: "/legal#conditions" },
      { label: "Confidentialité", href: "/legal#confidentialite" },
      { label: "Cookies", href: "/legal#cookies" },
    ],
  },
];
---

<Base title={title} description={description}>
  <header class="border-b border-[var(--color-line)] bg-[var(--color-surface)]">
    <div class="mx-auto w-full max-w-[1440px] px-6 lg:px-12">
      <div
        class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3 md:h-12 md:flex-nowrap md:py-0"
      >
        <a
          href="/"
          class="text-[15px] font-semibold tracking-[3px] text-[var(--color-ink)]"
          >AURA</a
        >

        <nav
          class="order-3 flex w-full flex-wrap items-center gap-x-5 gap-y-2 md:order-none md:w-auto md:gap-x-[30px]"
          aria-label="Principale"
        >
          {
            nav.map((lien) =>
              lien.href ? (
                <a
                  href={lien.href}
                  class="text-xs text-[var(--color-ink)] transition hover:text-[var(--color-accent)]"
                >
                  {lien.label}
                </a>
              ) : (
                <span class="text-xs text-[var(--color-muted)]">{lien.label}</span>
              ),
            )
          }
        </nav>

        <div class="flex items-center gap-5">
          <a
            href="/boutique"
            aria-label="Rechercher"
            class="transition hover:opacity-60"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </a>
          <a
            href="/boutique"
            aria-label="Panier"
            class="transition hover:opacity-60"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
              <path d="M3 6h18"></path>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="border-t border-[var(--color-line)] bg-white">
    <div
      class="mx-auto flex w-full max-w-[1440px] flex-col gap-7 px-6 py-12 lg:px-12"
    >
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          colonnes.map((colonne) => (
            <div class="flex flex-col gap-2.5">
              <p class="text-xs font-semibold text-[var(--color-ink)]">
                {colonne.titre}
              </p>
              <ul class="flex flex-col gap-2.5">
                {colonne.liens.map((lien) => (
                  <li>
                    {lien.href ? (
                      <a
                        href={lien.href}
                        class="text-xs text-[var(--color-muted)] transition hover:text-[var(--color-ink)]"
                      >
                        {lien.label}
                      </a>
                    ) : (
                      <span class="text-xs text-[var(--color-muted)]">
                        {lien.label}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="text-xs text-[var(--color-muted)]">
        © 2026 AURA. Tous droits réservés.
      </p>
    </div>
  </footer>
</Base>
